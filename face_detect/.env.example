# Face-Detect-MERN-Stack Local Face AI Service (FastAPI) - Port 8001
PORT=8001
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/<db_name>?retryWrites=true&w=majority
DB_NAME=test
TOLERANCE_THRESHOLD=0.40
ANTI_SPOOF_THRESHOLD=0.65

# Token xác thực nội bộ để bảo vệ endpoint /refresh và /sync-mongo (chỉ Central AI 8000 được gọi)
FACE_AI_INTERNAL_TOKEN=your-internal-refresh-token-change-in-production
