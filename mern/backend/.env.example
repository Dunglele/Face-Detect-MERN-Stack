# =============================================================================
# FACE-DETECT MERN STACK - EMPLOYEE BFF & KIOSK BACKEND (.env.example)
# =============================================================================
# Cổng chạy Employee BFF & Kiosk Backend (Port 5000)
PORT=5000

# CƠ SỞ DỮ LIỆU DÙNG CHUNG (BẮT BUỘC TRÙNG 100% VỚI AIAttendanceWeb3)
# Dùng chung collection: users, attendancerecords, leaverequests, shifts, shiftassignments, kpitasks
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/<db_name>?retryWrites=true&w=majority

# KHÓA BẢO MẬT JWT (BẮT BUỘC TRÙNG 100% VỚI AIAttendanceWeb3 ĐỂ LIÊN THÔNG XÁC THỰC)
JWT_SECRET=your-shared-secure-jwt-secret-key-min-32-characters-change-in-production

# KHÓA KÝ BẰNG CHỨNG XÁC THỰC KHUÔN MẶT RIÊNG (Tách biệt khỏi shared login JWT để chống giả mạo điểm AI)
FACE_VERIFICATION_SECRET=your-face-verification-secret-min-32-chars-change-in-production


# ĐỊA CHỈ CENTRAL BUSINESS BACKEND (AIAttendanceWeb3 Backend - Port 4000)
CENTRAL_BACKEND_URL=http://localhost:4000

# ĐỊA CHỈ CENTRAL AI HUB SERVICE (PhoBERT NLU & Face Enrollment - Port 8000)
AI_SERVICE_URL=http://localhost:8000
PYTHON_SERVICE_URL=http://localhost:8000

# ĐỊA CHỈ LOCAL FACE AI SERVICE (YOLOv11 Face Verification & Anti-Spoofing - Port 8001)
FACE_AI_URL=http://localhost:8001

# Môi trường chạy
NODE_ENV=development
